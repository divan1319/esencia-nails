{
  "name": "esencia-nails",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "NUXT_TELEMETRY_DISABLED=1 nuxt prepare",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env server/db/seed.ts",
    "check": "tsx --env-file=.env scripts/check-connection.ts",
    "test": "tsx --env-file=.env --test tests/logic.test.ts tests/phase1.test.ts tests/phase2.test.ts tests/phase3.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@neondatabase/serverless": "^1.2.0",
    "@nuxt/ui": "^4.11.3",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "h3": "^1.15.1",
    "nuxt": "^4.6.0",
    "tailwindcss": "^4.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@iconify-json/material-symbols": "^1.2.14",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
